#!/usr/bin/env bash
# The linker of x86_64-unknown-linux-gnu programs, glibc 2.35 as the ceiling. The -L finds the libasound.so.2 and
# libudev.so.1 that the game's dylibs need at the executable's link.
exec zig cc -target x86_64-linux-gnu.2.35 -Wl,--allow-shlib-undefined -L/usr/lib/x86_64-linux-gnu "$@"
